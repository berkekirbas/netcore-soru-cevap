@{
    ViewData["Title"] = "Soru Sor";
    var categories = ViewBag.Categories as IEnumerable<SoruCevapPortal.Models.Category>;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card-custom">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-question-circle fa-2x"></i>
                        </div>
                        <h2 class="fw-bold">Yeni Soru Sor</h2>
                        <p class="text-muted">Topluluğumuza sorunuzu sorun ve cevaplar alın</p>
                    </div>

                    <form asp-action="Create" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-heading me-2 text-primary"></i>Başlık
                            </label>
                            <input type="text" name="title" class="form-control form-control-lg" 
                                   placeholder="Sorunuzun başlığını yazın..." required />
                            <small class="text-muted">Açıklayıcı ve özlü bir başlık yazın</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-folder me-2 text-primary"></i>Kategori
                            </label>
                            <select name="categoryId" class="form-select form-select-lg" required>
                                <option value="">Kategori seçin...</option>
                                @if (categories != null)
                                {
                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-align-left me-2 text-primary"></i>İçerik
                            </label>
                            <textarea name="content" class="form-control" rows="8" 
                                      placeholder="Sorunuzu detaylı bir şekilde açıklayın..." required></textarea>
                            <small class="text-muted">Ne kadar detaylı açıklarsanız, o kadar iyi cevaplar alırsınız</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-paper-plane me-2"></i>Soruyu Gönder
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Vazgeç
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Tips -->
            <div class="card-custom mt-4 p-4">
                <h6 class="fw-bold mb-3"><i class="fas fa-lightbulb text-warning me-2"></i>İyi Bir Soru Nasıl Sorulur?</h6>
                <ul class="mb-0 ps-3">
                    <li class="mb-2">Sorununuzu açık ve net bir şekilde tanımlayın</li>
                    <li class="mb-2">Daha önce denediğiniz çözümleri belirtin</li>
                    <li class="mb-2">İlgili detayları ve bağlamı ekleyin</li>
                    <li class="mb-2">Doğru kategoriyi seçin</li>
                    <li>Anlaşılır bir başlık kullanın</li>
                </ul>
            </div>
        </div>
    </div>
</div>

