@model SoruCevapPortal.Models.Question
@{
    ViewData["Title"] = Model.Title;
    var approvedAnswers = Model.Answers?.Where(a => a.IsApproved && a.IsActive).OrderByDescending(a => a.CreatedAt).ToList();
    var answerCount = approvedAnswers?.Count ?? 0;
}

<div class="row">
    <div class="col-md-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category?.Name</a></li>
                <li class="breadcrumb-item active" aria-current="page">Soru Detayı</li>
            </ol>
        </nav>

        <!-- Soru Kartı -->
        <div class="card mb-4 shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-question-circle me-2"></i>@Model.Title</h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <p class="fs-5">@Model.Content</p>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-2">
                            <i class="fas fa-user text-primary me-2"></i>
                            <strong>Soran:</strong> @Model.User?.Username
                        </p>
                        <p class="mb-2">
                            <i class="fas fa-folder text-primary me-2"></i>
                            <strong>Kategori:</strong>
                            <span class="badge bg-primary">@Model.Category?.Name</span>
                        </p>
                    </div>
                    <div class="col-md-6 text-end">
                        <p class="mb-2">
                            <i class="fas fa-eye text-muted me-2"></i>
                            <strong>Görüntülenme:</strong> @Model.ViewCount
                        </p>
                        <p class="mb-2">
                            <i class="fas fa-clock text-muted me-2"></i>
                            <strong>Tarih:</strong> @Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cevaplar Bölümü -->
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="fas fa-comments me-2"></i>
                    Cevaplar (@answerCount)
                </h5>
            </div>
            <div class="card-body">
                @if (approvedAnswers != null && approvedAnswers.Any())
                {
                    @foreach (var answer in approvedAnswers)
                    {
                        <div class="card mb-3 border-start border-success border-4">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <i class="fas fa-user-circle text-success fa-2x me-2"></i>
                                        <strong class="fs-5">@answer.User?.Username</strong>
                                    </div>
                                    <div class="text-muted small">
                                        <i class="fas fa-clock me-1"></i>
                                        @answer.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                        @if (answer.UpdatedAt.HasValue)
                                        {
                                            <span class="ms-2">(Düzenlendi: @answer.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm"))</span>
                                        }
                                    </div>
                                </div>
                                <div class="ms-5">
                                    <p class="mb-0 fs-6">@answer.Content</p>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-comment-slash fa-4x text-muted mb-3"></i>
                        <h5 class="text-muted">Henüz onaylanmış cevap bulunmuyor</h5>
                        <p class="text-muted">Bu soruya henüz kimse cevap vermemiş veya cevaplar onay bekliyor.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Geri Dön Butonu -->
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Sorulara Geri Dön
            </a>
        </div>
    </div>
</div>
