@model SoruCevapPortal.Models.Question
@{
    ViewData["Title"] = Model.Title;
    var approvedAnswers = Model.Answers?.Where(a => a.IsApproved && a.IsActive).OrderByDescending(a => a.CreatedAt).ToList();
    var answerCount = approvedAnswers?.Count ?? 0;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                    <i class="fas fa-home me-1"></i>Ana Sayfa
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none">
                    @Model.Category?.Name
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Soru</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-lg-8">
            <!-- Question Card -->
            <div class="card-custom mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <span class="badge-category mb-2 d-inline-block">@Model.Category?.Name</span>
                            <h2 class="h3 fw-bold mb-0">@Model.Title</h2>
                        </div>
                    </div>
                    
                    <div class="question-content mb-4">
                        <p class="fs-5 text-dark lh-lg">@Model.Content</p>
                    </div>
                    
                    <hr />
                    
                    <div class="d-flex flex-wrap justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <div class="user-avatar">
                                @(Model.User?.UserName?.Substring(0, 1).ToUpper() ?? "?")
                            </div>
                            <div>
                                <strong>@Model.User?.UserName</strong>
                                <div class="text-muted small">
                                    <i class="fas fa-clock me-1"></i>@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")
                                </div>
                            </div>
                        </div>
                        <div class="d-flex gap-4 text-muted">
                            <span><i class="fas fa-eye me-1"></i>@Model.ViewCount görüntülenme</span>
                            <span><i class="fas fa-comments me-1"></i>@answerCount cevap</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Answers Section -->
            <div class="card-custom">
                <div class="card-header bg-white p-4">
                    <h5 class="mb-0 d-flex align-items-center">
                        <i class="fas fa-comments text-success me-2"></i>
                        Cevaplar
                        <span class="badge bg-success ms-2 rounded-pill">@answerCount</span>
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (approvedAnswers != null && approvedAnswers.Any())
                    {
                        @foreach (var answer in approvedAnswers)
                        {
                            <div class="answer-item mb-4 pb-4 border-bottom">
                                <div class="d-flex gap-3">
                                    <div class="user-avatar flex-shrink-0" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                                        @(answer.User?.UserName?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <strong>@answer.User?.UserName</strong>
                                                <span class="badge bg-success ms-2">Onaylı Cevap</span>
                                            </div>
                                            <small class="text-muted">
                                                <i class="fas fa-clock me-1"></i>@answer.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                            </small>
                                        </div>
                                        <p class="mb-0 text-dark lh-lg">@answer.Content</p>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-comment-slash fa-3x text-muted mb-3 opacity-50"></i>
                            <h6 class="text-muted">Henüz onaylanmış cevap yok</h6>
                            <p class="text-muted small mb-0">İlk cevabı siz verin!</p>
                        </div>
                    }

                    <!-- Answer Form -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <hr class="my-4" />
                        <div class="answer-form">
                            <h6 class="mb-3"><i class="fas fa-reply me-2 text-primary"></i>Cevabınızı Yazın</h6>
                            <form asp-controller="Question" asp-action="Answer" method="post">
                                <input type="hidden" name="questionId" value="@Model.Id" />
                                <div class="mb-3">
                                    <textarea name="content" class="form-control" rows="4" placeholder="Cevabınızı buraya yazın..." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-paper-plane me-2"></i>Cevap Gönder
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-4">
                            <i class="fas fa-info-circle me-2"></i>
                            Cevap vermek için <a asp-controller="Account" asp-action="Login">giriş yapın</a> veya 
                            <a asp-controller="Account" asp-action="Register">kayıt olun</a>.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="card-custom p-4 mb-4">
                <h6 class="sidebar-title">Soru İstatistikleri</h6>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Görüntülenme</span>
                    <strong>@Model.ViewCount</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Cevap Sayısı</span>
                    <strong>@answerCount</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Oluşturulma</span>
                    <strong>@Model.CreatedAt.ToString("dd.MM.yyyy")</strong>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted">Kategori</span>
                    <span class="badge-category">@Model.Category?.Name</span>
                </div>
            </div>

            <div class="card-custom p-4">
                <h6 class="sidebar-title">Hızlı Linkler</h6>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary w-100 mb-2">
                    <i class="fas fa-arrow-left me-2"></i>Tüm Sorular
                </a>
                <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-folder me-2"></i>@Model.Category?.Name Soruları
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .answer-item:last-child {
        border-bottom: none !important;
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
    }
</style>
