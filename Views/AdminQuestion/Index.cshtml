@model SoruCevapPortal.Models.PagedList<SoruCevapPortal.Models.Question>
@{
    ViewData["Title"] = "Sorular";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Sorular</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Yeni Soru
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <div>
                    <strong>Toplam @Model.TotalCount soru</strong> - Sayfa @Model.PageNumber / @Model.TotalPages
                </div>
                <div>
                    <span class="text-muted">Sayfa başına @Model.PageSize kayıt</span>
                </div>
            </div>

            @if (Model.Items.Any())
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Başlık</th>
                            <th>Kullanıcı</th>
                            <th>Kategori</th>
                            <th>Aktif</th>
                            <th>Görüntülenme</th>
                            <th>Oluşturulma</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Title</td>
                                <td>@item.User?.UserName</td>
                                <td>@item.Category?.Name</td>
                                <td>
                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary") status-badge-@item.Id">
                                        @(item.IsActive ? "Aktif" : "Pasif")
                                    </span>
                                </td>
                                <td>@item.ViewCount</td>
                                <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Detay">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button class="btn btn-sm btn-secondary toggle-question" data-id="@item.Id" title="@(item.IsActive ? "Pasif Yap" : "Aktif Yap")">
                                        <i class="fas fa-toggle-@(item.IsActive ? "on" : "off")"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger delete-question" data-id="@item.Id" title="Sil">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Sayfa navigasyonu">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">
                                    <i class="fas fa-chevron-left"></i> Önceki
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">
                                    Sonraki <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-question-circle"></i>
                    <h4>Henüz soru bulunmuyor</h4>
                    <p>İlk soruyu oluşturmak için yukarıdaki "Yeni Soru" butonuna tıklayın.</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Soru Oluştur
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.toggle-question').click(function() {
                var id = $(this).data('id');
                var button = $(this);
                LoadingOverlay.show();

                $.ajax({
                    url: '@Url.Action("ToggleActive", "AdminQuestion")',
                    type: 'POST',
                    data: { id: id },
                    success: function(response) {
                        LoadingOverlay.hide();
                        if (response.success) {
                            var badge = $('.status-badge-' + id);
                            if (response.isActive) {
                                badge.removeClass('bg-secondary').addClass('bg-success').text('Aktif');
                                button.html('<i class="fas fa-toggle-on"></i>');
                                button.attr('title', 'Pasif Yap');
                                ToastNotification.success('Soru aktif hale getirildi.');
                            } else {
                                badge.removeClass('bg-success').addClass('bg-secondary').text('Pasif');
                                button.html('<i class="fas fa-toggle-off"></i>');
                                button.attr('title', 'Aktif Yap');
                                ToastNotification.success('Soru pasif hale getirildi.');
                            }
                        } else {
                            ToastNotification.error(response.message);
                        }
                    },
                    error: function() {
                        LoadingOverlay.hide();
                        ToastNotification.error('Bir hata oluştu.');
                    }
                });
            });

            $('.delete-question').click(function() {
                var id = $(this).data('id');
                if (confirm('Bu soruyu silmek istediğinize emin misiniz?')) {
                    LoadingOverlay.show();
                    $.ajax({
                        url: '@Url.Action("Delete", "AdminQuestion")',
                        type: 'POST',
                        data: { id: id },
                        success: function(response) {
                            LoadingOverlay.hide();
                            if (response.success) {
                                ToastNotification.success(response.message);
                                setTimeout(function() {
                                    location.reload();
                                }, 1000);
                            } else {
                                ToastNotification.error(response.message);
                            }
                        },
                        error: function() {
                            LoadingOverlay.hide();
                            ToastNotification.error('Bir hata oluştu.');
                        }
                    });
                }
            });
        });
    </script>
}

