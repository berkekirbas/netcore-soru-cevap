@model SoruCevapPortal.Models.Question
@{
    ViewData["Title"] = "Soru Detayı";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Soru Detayı</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i> Düzenle
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Geri
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">@Model.Title</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>İçerik:</strong>
                        <p class="mt-2">@Model.Content</p>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Kullanıcı:</strong> @Model.User?.Username</p>
                            <p><strong>Kategori:</strong> @Model.Category?.Name</p>
                            <p><strong>Görüntülenme:</strong> @Model.ViewCount</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Durum:</strong> 
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </p>
                            <p><strong>Oluşturulma:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <p><strong>Güncellenme:</strong> @Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Answers != null && Model.Answers.Any())
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">Cevaplar (@Model.Answers.Count)</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var answer in Model.Answers.OrderByDescending(a => a.CreatedAt))
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <strong>@answer.User?.Username</strong>
                                        <span class="text-muted ms-2">@answer.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                    </div>
                                    <div>
                                        @if (answer.IsApproved)
                                        {
                                            <span class="badge bg-success">Onaylı</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Onay Bekliyor</span>
                                        }
                                        @if (!answer.IsActive)
                                        {
                                            <span class="badge bg-secondary">Pasif</span>
                                        }
                                    </div>
                                </div>
                                <p>@answer.Content</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>



