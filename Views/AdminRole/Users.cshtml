@model IEnumerable<SoruCevapPortal.Models.ApplicationUser>
@{
    ViewData["Title"] = $"{ViewBag.RoleName} Rolündeki Kullanıcılar";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none">
            <i class="fas fa-arrow-left me-2"></i>Rollere Dön
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="fas fa-users me-2 text-primary"></i>
            <span class="badge bg-primary me-2">@ViewBag.RoleName</span>
            rolündeki kullanıcılar
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Kullanıcı</th>
                            <th>E-posta</th>
                            <th>Durum</th>
                            <th>Kayıt Tarihi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <span>@user.UserName?.Substring(0, 1).ToUpper()</span>
                                        </div>
                                        <div>
                                            <span class="fw-semibold">@user.UserName</span>
                                            @if (!string.IsNullOrEmpty(user.FullName))
                                            {
                                                <br /><small class="text-muted">@user.FullName</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Pasif</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-users-slash fa-3x mb-3"></i>
                <h5>Bu rolde kullanıcı yok</h5>
                <p class="mb-0">Kullanıcıları bu role atamak için Kullanıcı Yönetimi sayfasını kullanın.</p>
            </div>
        }
    </div>
</div>

