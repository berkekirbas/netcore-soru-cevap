@model IEnumerable<AdminUserViewModel>
@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">Toplam @Model.Count() kullanıcı</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-user-plus me-2"></i>Yeni Kullanıcı
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Kullanıcı</th>
                        <th>E-posta</th>
                        <th>Roller</th>
                        <th>Durum</th>
                        <th>Kayıt Tarihi</th>
                        <th width="150">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <span class="fw-bold">@user.UserName.Substring(0, 1).ToUpper()</span>
                                    </div>
                                    <div>
                                        <span class="fw-semibold">@user.UserName</span>
                                        @if (!string.IsNullOrEmpty(user.FullName))
                                        {
                                            <br /><small class="text-muted">@user.FullName</small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    var badgeClass = role == "Admin" ? "bg-danger" : (role == "Moderator" ? "bg-warning" : "bg-secondary");
                                    <span class="badge @badgeClass me-1">@role</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pasif</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-warning" onclick="toggleActive(@user.Id)" title="Durum Değiştir">
                                        <i class="fas fa-power-off"></i>
                                    </button>
                                    @if (user.UserName != User.Identity?.Name)
                                    {
                                        <button type="button" class="btn btn-outline-danger" onclick="deleteUser(@user.Id, '@user.UserName')" title="Sil">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Kullanıcıyı Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong id="deleteUserName"></strong> kullanıcısını silmek istediğinizden emin misiniz?</p>
                <p class="text-danger small mb-0">Bu işlem geri alınamaz!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Sil</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let deleteUserId = null;
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

        function deleteUser(id, name) {
            deleteUserId = id;
            document.getElementById('deleteUserName').textContent = name;
            deleteModal.show();
        }

        document.getElementById('confirmDelete').addEventListener('click', async function() {
            if (!deleteUserId) return;

            try {
                const response = await fetch('/AdminUser/Delete/' + deleteUserId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const result = await response.json();

                if (result.success) {
                    showToast(result.message, 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(result.message, 'error');
                }
            } catch (error) {
                showToast('Bir hata oluştu', 'error');
            }

            deleteModal.hide();
        });

        async function toggleActive(id) {
            try {
                const response = await fetch('/AdminUser/ToggleActive/' + id, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const result = await response.json();

                if (result.success) {
                    showToast(result.message, 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(result.message, 'error');
                }
            } catch (error) {
                showToast('Bir hata oluştu', 'error');
            }
        }
    </script>
}
