@model IEnumerable<SoruCevapPortal.Models.User>
@{
    ViewData["Title"] = "Kullanıcılar";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Kullanıcılar</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Yeni Kullanıcı
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kullanıcı Adı</th>
                            <th>E-posta</th>
                            <th>Ad Soyad</th>
                            <th>Roller</th>
                            <th>Aktif</th>
                            <th>Oluşturulma</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Username</td>
                                <td>@item.Email</td>
                                <td>@(item.FullName ?? "-")</td>
                                <td>
                                    @foreach (var role in item.UserRoles)
                                    {
                                        <span class="badge bg-primary me-1">@role.Role.Name</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>
                                <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button class="btn btn-sm btn-danger delete-user" data-id="@item.Id" title="Sil">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-users"></i>
                    <h4>Henüz kullanıcı bulunmuyor</h4>
                    <p>İlk kullanıcıyı oluşturmak için yukarıdaki "Yeni Kullanıcı" butonuna tıklayın.</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Kullanıcı Oluştur
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.delete-user').click(function() {
                var id = $(this).data('id');
                if (confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?')) {
                    LoadingOverlay.show();
                    $.ajax({
                        url: '@Url.Action("Delete", "AdminUser")',
                        type: 'POST',
                        data: { id: id },
                        success: function(response) {
                            LoadingOverlay.hide();
                            if (response.success) {
                                ToastNotification.success(response.message);
                                setTimeout(function() {
                                    location.reload();
                                }, 1000);
                            } else {
                                ToastNotification.error(response.message);
                            }
                        },
                        error: function() {
                            LoadingOverlay.hide();
                            ToastNotification.error('Bir hata oluştu.');
                        }
                    });
                }
            });
        });
    </script>
}

