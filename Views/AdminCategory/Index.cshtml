@model IEnumerable<SoruCevapPortal.Models.Category>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Kategoriler</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Yeni Kategori
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Ad</th>
                            <th>Açıklama</th>
                            <th>Aktif</th>
                            <th>Oluşturulma</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Name</td>
                                <td>@(item.Description ?? "-")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>
                                <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button class="btn btn-sm btn-danger delete-category" data-id="@item.Id">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-folder-open"></i>
                    <h4>Henüz kategori bulunmuyor</h4>
                    <p>İlk kategoriyi oluşturmak için yukarıdaki "Yeni Kategori" butonuna tıklayın.</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Kategori Oluştur
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.delete-category').click(function() {
                var id = $(this).data('id');
                if (confirm('Bu kategoriyi silmek istediğinize emin misiniz?')) {
                    LoadingOverlay.show();
                    $.ajax({
                        url: '@Url.Action("Delete", "AdminCategory")',
                        type: 'POST',
                        data: { id: id },
                        success: function(response) {
                            LoadingOverlay.hide();
                            if (response.success) {
                                ToastNotification.success(response.message);
                                setTimeout(function() {
                                    location.reload();
                                }, 1000);
                            } else {
                                ToastNotification.error(response.message);
                            }
                        },
                        error: function() {
                            LoadingOverlay.hide();
                            ToastNotification.error('Bir hata oluştu.');
                        }
                    });
                }
            });
        });
    </script>
}

